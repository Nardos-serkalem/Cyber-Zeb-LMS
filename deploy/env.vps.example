# Copy to backend/.env on the VPS:
#   cp deploy/env.vps.example backend/.env
#
# Replace YOUR_VPS_IP and BRANA_PORT with your values (port must match BRANA_PORT when starting).

APP_NAME=Brana LMS API
APP_ENV=production
API_V1_PREFIX=/api/v1
DEBUG=false

# SQLite — no PostgreSQL required on a shared VPS
DATABASE_URL=sqlite+aiosqlite:///./brana_lms.db
DATABASE_URL_SYNC=sqlite:///./brana_lms.db

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

REDIS_URL=redis://localhost:6379/0

# Must include the URL stakeholders will open in the browser
CORS_ORIGINS=["http://YOUR_VPS_IP:7777","https://YOUR_VPS_IP:8443"]

# Zoom — for Docker, put these in the project-root .env instead
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_EMAIL=
